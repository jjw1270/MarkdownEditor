<Window x:Class="MarkDownEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Markdown" Height="720" Width="960" MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen">
    <!-- OS 제목표시줄 제거: 웹의 상단 바(탭+툴바)가 타이틀바 역할까지 한다 (Win11 메모장 방식).
         드래그·리사이즈·창 버튼은 웹이 메시지로 요청하고 C#이 네이티브로 처리 -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="-1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="Root">
        <wv2:WebView2 x:Name="Web" />

        <!-- 로딩 스플래시: WebView2 부팅~첫 렌더 사이의 빈 화면을 가림 (ready 수신 시 사라짐) -->
        <Grid x:Name="Splash">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="SplashSpinner"
                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                From="0" To="360" Duration="0:0:0.85" RepeatBehavior="Forever" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="46" Height="46" HorizontalAlignment="Center">
                    <Ellipse x:Name="SplashTrack" Width="46" Height="46" StrokeThickness="4" />
                    <Ellipse x:Name="SplashSpinner" Width="46" Height="46" StrokeThickness="4"
                             StrokeDashArray="9 23" StrokeDashCap="Round"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <TextBlock x:Name="SplashTitle" Text="Markdown" FontSize="18" FontWeight="SemiBold"
                           FontFamily="Segoe UI, 맑은 고딕, Malgun Gothic"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock x:Name="SplashSub" Text="로딩 중…" FontSize="12"
                           FontFamily="Segoe UI, 맑은 고딕, Malgun Gothic"
                           HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
