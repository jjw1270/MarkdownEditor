<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MarkDownEditor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon_New.ico</ApplicationIcon>
    <Version>1.1.1</Version>
    <Product>MarkDownEditor</Product>
    <Copyright>Copyright (c) 2026 jjw1270</Copyright>
    <RepositoryUrl>https://github.com/jjw1270/MarkdownEditor</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <!-- web/ 폴더 전체를 출력 폴더로 복사 (WebView2가 로컬 로드) -->
  <ItemGroup>
    <None Include="web\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="web\" />
  </ItemGroup>

</Project>
